APP_NAME="لمسة التميز CMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cms.example.com
PRODUCTION_URL=https://lams-event.com
APP_TIMEZONE=Asia/Riyadh
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lamasaevent
DB_USERNAME=lamasaevent_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
MEDIA_DISK=public

CORS_ALLOWED_ORIGINS=https://staging.example.com
LEGACY_DIST=
LEGACY_MANIFEST=../route-manifest.json

# LOCAL_ADMIN_* must never be set in production.
