---
import { integrateNativeListings } from "../lib/native-listings";
import type { ContentBlock, ContentEntity } from "../types/content";

interface Props {
  blocks: ContentBlock[];
  title?: string;
  summary?: string | null;
  heroMedia?: ContentEntity["hero_media_summary"];
  routePath: string;
}

const { blocks, title, summary, heroMedia, routePath } = Astro.props;
const integrated = integrateNativeListings(blocks, routePath);
---

<main id="main">
  {integrated.blocks.length > 0 ? (
    integrated.blocks.map((block) => <Fragment set:html={block.html} />)
  ) : (
    <article class="container" style="padding-block: clamp(3rem, 8vw, 7rem);">
      {heroMedia && (
        <figure style="margin: 0 0 2rem;">
          <img
            src={heroMedia.public_url}
            alt={heroMedia.alt || title || heroMedia.original_name}
            style="display: block; width: 100%; max-height: 34rem; object-fit: cover; border-radius: 1rem;"
          />
        </figure>
      )}
      {title && <h1>{title}</h1>}
      {summary && <p>{summary}</p>}
    </article>
  )}
  {integrated.supplementalHtml && (
    <Fragment set:html={integrated.supplementalHtml} />
  )}
</main>
