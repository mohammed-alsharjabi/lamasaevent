---
const navigation = [
  ["/", "الرئيسية"],
  ["/about", "من نحن"],
  ["/services", "الخدمات"],
  ["/areas", "المناطق"],
  ["/gallery", "المعرض"],
  ["/blog", "المدونة"],
  ["/contact", "تواصل"],
] as const;
---

<div class="site-header-wrap">
  <input type="checkbox" id="site-nav-toggle" class="site-header__checkbox visually-hidden" />
  <header class="site-header">
    <div class="site-header__bar">
      <div class="container site-header__bar-inner">
        <div class="site-header__start">
          <a class="site-header__brand brand site-header__brand--with-logo" href="/">
            <img
              class="site-header__logo"
              src="/icons/logo-without-bg.png"
              alt=""
              width="520"
              height="480"
              decoding="async"
            />
            <span class="site-header__brand-text">
              <span class="site-header__brand-name">لمسه التميز</span>
              <span class="brand__tag">تنسيق مناسبات — الرياض</span>
            </span>
          </a>
          <nav class="site-header__nav site-header__nav--desktop" aria-label="التنقل الرئيسي">
            {navigation.map(([href, label]) => (
              <a class="site-header__link" href={href}>{label}</a>
            ))}
          </nav>
        </div>
        <div class="site-header__end">
          <a href="/contact" class="ui-btn ui-btn--primary site-header__cta site-header__cta--bar">
            طلب عرض
          </a>
          <label
            for="site-nav-toggle"
            class="site-header__menu-btn"
            aria-label="فتح القائمة"
            id="site-nav-toggle-label"
          >
            <span class="site-header__menu-icon" aria-hidden="true">
              <span class="site-header__menu-line"></span>
              <span class="site-header__menu-line"></span>
              <span class="site-header__menu-line"></span>
            </span>
          </label>
        </div>
      </div>
    </div>
  </header>
  <label for="site-nav-toggle" class="site-header__scrim" aria-hidden="true"></label>
  <div class="site-header__drawer" role="dialog" aria-modal="true" aria-labelledby="site-nav-drawer-title">
    <div class="site-header__drawer-head">
      <div class="site-header__drawer-brand">
        <img
          class="site-header__drawer-logo"
          src="/icons/logo-without-bg.png"
          alt=""
          width="520"
          height="480"
          decoding="async"
        />
        <p id="site-nav-drawer-title" class="site-header__drawer-title">لمسه التميز</p>
      </div>
      <label for="site-nav-toggle" class="site-header__drawer-close" aria-label="إغلاق القائمة">
        <span class="site-header__drawer-close-icon" aria-hidden="true"></span>
      </label>
    </div>
    <nav class="site-header__nav site-header__nav--mobile" aria-label="التنقل الرئيسي">
      {navigation.map(([href, label]) => (
        <a class="site-header__drawer-link" href={href}>{label}</a>
      ))}
    </nav>
    <div class="site-header__drawer-cta">
      <a href="/contact" class="ui-btn ui-btn--primary site-header__cta site-header__cta--drawer">
        طلب عرض
      </a>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var toggle = document.getElementById("site-nav-toggle");
    var label = document.getElementById("site-nav-toggle-label");
    if (!toggle || !label) return;
    function sync() {
      var open = toggle.checked;
      label.setAttribute("aria-label", open ? "إغلاق القائمة" : "فتح القائمة");
      label.setAttribute("aria-expanded", open ? "true" : "false");
    }
    toggle.addEventListener("change", sync);
    sync();
    document.addEventListener("keydown", function (event) {
      if (event.key === "Escape" && toggle.checked) {
        toggle.checked = false;
        toggle.dispatchEvent(new Event("change"));
      }
    });
  })();
</script>
