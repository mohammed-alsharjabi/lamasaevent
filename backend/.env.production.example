APP_NAME="لمسة التميز CMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lams-event.com
PRODUCTION_URL=https://lams-event.com
APP_TIMEZONE=Asia/Riyadh
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lamasaevent
DB_USERNAME=lamasaevent_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=240
QUEUE_FAILED_DRIVER=database-uuids
CACHE_STORE=database
FILESYSTEM_DISK=local
MEDIA_DISK=public
MEDIA_MAX_BYTES=8388608
MEDIA_MAX_WIDTH=12000
MEDIA_MAX_HEIGHT=12000
MEDIA_MAX_PIXELS=40000000
MEDIA_WEBP_QUALITY=82

CORS_ALLOWED_ORIGINS=https://lams-event.com
LEGACY_DIST=
LEGACY_MANIFEST=../route-manifest.json

# Set this to the shared release snapshot consumed by the Astro build worker.
# FRONTEND_CONTENT_SNAPSHOT_PATH=/srv/lamasaevent/shared/content-export.json

# Shared-hosting Astro publish bridge. Keep disabled until the repository
# deploy key and GitHub Actions Hostinger secrets are configured.
FRONTEND_GIT_PUBLISH_ENABLED=false
FRONTEND_GIT_REPOSITORY_ROOT=
FRONTEND_GIT_SNAPSHOT_PATH=frontend/src/data/content-export.json
FRONTEND_GIT_REMOTE=git@github.com:mohammed-alsharjabi/lamasaevent.git
FRONTEND_GIT_BRANCH=feature/admin-cms
FRONTEND_GIT_SSH_KEY_PATH=

# LOCAL_ADMIN_* must never be set in production.
