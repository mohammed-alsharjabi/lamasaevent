---
import {
  areas,
  articles,
  galleries,
  pages,
  serviceCategories,
  services,
} from "../lib/content";
import type { ContentEntity } from "../types/content";

interface Props {
  routePath: string;
}

interface Addition {
  entity: ContentEntity;
  kind: string;
}

const { routePath } = Astro.props;
const isNew = (entity: ContentEntity) => entity.legacy_path === null;
const additions = (
  entities: ContentEntity[],
  kind: string,
): Addition[] => entities.filter(isNew).map((entity) => ({ entity, kind }));

let heading = "";
let intro = "";
let entries: Addition[] = [];

if (routePath === "/") {
  heading = "أحدث الإضافات";
  intro = "محتوى منشور حديثًا من لوحة التحكم.";
  entries = [
    ...additions(serviceCategories, "تصنيف خدمات"),
    ...additions(services, "خدمة"),
    ...additions(areas, "منطقة"),
    ...additions(articles, "مقال"),
    ...additions(pages, "صفحة"),
  ];
} else if (routePath === "/services") {
  heading = "خدمات منشورة حديثًا";
  intro = "الخدمات والتصنيفات الجديدة المضافة من لوحة التحكم.";
  entries = [
    ...additions(serviceCategories, "تصنيف خدمات"),
    ...additions(services, "خدمة"),
  ];
} else if (routePath === "/blog") {
  heading = "مقالات منشورة حديثًا";
  intro = "المقالات الجديدة المضافة من لوحة التحكم.";
  entries = additions(articles, "مقال");
} else if (routePath === "/areas") {
  heading = "مناطق منشورة حديثًا";
  intro = "المناطق الجديدة المضافة من لوحة التحكم.";
  entries = additions(areas, "منطقة");
} else {
  const parent = services.find(
    (service) => (service.public_path ?? service.legacy_path) === routePath,
  );

  if (parent) {
    heading = "الخدمات الفرعية";
    intro = `خدمات منشورة تابعة لـ ${parent.title}.`;
    entries = additions(services, "خدمة فرعية").filter(
      ({ entity }) =>
        (entity.parent as { id?: number } | null | undefined)?.id === parent.id,
    );
  }
}

entries = entries
  .filter(
    ({ entity }, index, all) =>
      all.findIndex(({ entity: candidate }) => (
        (candidate.public_path ?? candidate.legacy_path) ===
        (entity.public_path ?? entity.legacy_path)
      )) === index,
  )
  .sort((left, right) => (
    Date.parse(right.entity.published_at) - Date.parse(left.entity.published_at)
  ))
  .slice(0, routePath === "/" ? 12 : 100);

const galleryAdditions = routePath === "/gallery"
  ? galleries.filter((gallery) => !gallery.is_legacy)
  : [];
---

{entries.length > 0 && (
  <section
    class="cms-additions"
    data-cms-additions
    aria-labelledby="cms-additions-heading"
  >
    <div class="container">
      <header class="cms-additions__header">
        <p class="cms-additions__eyebrow">من لوحة التحكم</p>
        <h2 id="cms-additions-heading">{heading}</h2>
        <p>{intro}</p>
      </header>
      <div class="cms-additions__grid">
        {entries.map(({ entity, kind }) => {
          const href = entity.public_path ?? entity.legacy_path ?? "/";
          const hero = entity.hero_media_summary;
          const parent = entity.parent as { title?: string } | null | undefined;
          const description = (
            entity.summary ||
            entity.excerpt ||
            (parent?.title ? `خدمة فرعية من ${parent.title}` : "")
          ) as string;

          return (
            <article class="cms-additions__card">
              <a href={href} aria-label={`عرض ${entity.title}`}>
                {hero && (
                  <div class="cms-additions__media">
                    <img
                      src={hero.public_url}
                      alt={hero.alt || entity.title}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}
                <div class="cms-additions__body">
                  <span class="cms-additions__kind">{kind}</span>
                  <h3>{entity.title}</h3>
                  {description && <p>{description}</p>}
                  <span class="cms-additions__more">عرض التفاصيل</span>
                </div>
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

{galleryAdditions.length > 0 && (
  <section
    class="cms-gallery-additions"
    data-cms-additions
    aria-labelledby="cms-gallery-additions-heading"
  >
    <div class="container">
      <header class="cms-additions__header">
        <p class="cms-additions__eyebrow">من لوحة التحكم</p>
        <h2 id="cms-gallery-additions-heading">معارض منشورة حديثًا</h2>
        <p>صور ومعارض جديدة مضافة من لوحة التحكم.</p>
      </header>
      {galleryAdditions.map((gallery) => {
        const images = gallery.items
          .filter((item) => item.is_active)
          .map((item) => ({
            id: item.id,
            title: item.title,
            alt: item.alt,
            caption: item.caption,
            media: item.media,
          }));

        return (
          <article class="cms-gallery-additions__gallery">
            <div class="cms-gallery-additions__intro">
              <h3>{gallery.title}</h3>
              {gallery.description && <p>{gallery.description}</p>}
            </div>
            {images.length > 0 ? (
              <div class="cms-gallery-additions__grid">
                {images.map((image) => (
                  <figure>
                    <img
                      src={image.media.public_url}
                      alt={image.alt || image.media.alt || image.title || gallery.title}
                      loading="lazy"
                      decoding="async"
                    />
                    {(image.caption || image.media.caption || image.title) && (
                      <figcaption>
                        {image.caption || image.media.caption || image.title}
                      </figcaption>
                    )}
                  </figure>
                ))}
              </div>
            ) : (
              <p class="cms-gallery-additions__empty">
                لم تُضف صور ظاهرة إلى هذا المعرض بعد.
              </p>
            )}
          </article>
        );
      })}
    </div>
  </section>
)}

<style>
  .cms-additions,
  .cms-gallery-additions {
    padding-block: clamp(3rem, 7vw, 6rem);
    background: rgba(255, 255, 255, 0.018);
    border-block: 1px solid rgba(255, 255, 255, 0.06);
  }

  .cms-gallery-additions__gallery + .cms-gallery-additions__gallery {
    margin-top: clamp(2rem, 5vw, 4rem);
    padding-top: clamp(2rem, 5vw, 4rem);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .cms-gallery-additions__intro {
    max-width: 46rem;
    margin-bottom: 1.25rem;
  }

  .cms-gallery-additions__intro h3 {
    margin: 0 0 0.55rem;
    color: #fff;
    font-size: clamp(1.2rem, 3vw, 1.65rem);
  }

  .cms-gallery-additions__intro p,
  .cms-gallery-additions__empty {
    margin: 0;
    color: rgba(255, 255, 255, 0.64);
    line-height: 1.8;
  }

  .cms-gallery-additions__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
  }

  .cms-gallery-additions__grid figure {
    overflow: hidden;
    margin: 0;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg, 12px);
  }

  .cms-gallery-additions__grid img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .cms-gallery-additions__grid figcaption {
    padding: 0.8rem 1rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .cms-additions__header {
    max-width: 48rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .cms-additions__header h2 {
    margin: 0.35rem 0 0.75rem;
    color: #fff;
    font-size: clamp(1.55rem, 4vw, 2.35rem);
  }

  .cms-additions__header > p:last-child {
    margin: 0;
    color: rgba(255, 255, 255, 0.68);
    line-height: 1.8;
  }

  .cms-additions__eyebrow,
  .cms-additions__kind,
  .cms-additions__more {
    color: var(--color-accent-tiffany, #81d8d0);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .cms-additions__eyebrow {
    margin: 0;
  }

  .cms-additions__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: clamp(1rem, 2.5vw, 1.35rem);
  }

  .cms-additions__card {
    min-width: 0;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg, 12px);
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .cms-additions__card:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(129, 216, 208, 0.42);
  }

  .cms-additions__card > a {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .cms-additions__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
  }

  .cms-additions__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cms-additions__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: clamp(1rem, 3vw, 1.35rem);
  }

  .cms-additions__body h3 {
    margin: 0.45rem 0 0.65rem;
    color: #fff;
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .cms-additions__body p {
    flex: 1;
    margin: 0;
    color: rgba(255, 255, 255, 0.64);
    font-size: 0.88rem;
    line-height: 1.8;
  }

  .cms-additions__more {
    margin-top: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .cms-additions__card {
      transition: none;
    }

    .cms-additions__card:hover {
      transform: none;
    }
  }
</style>
