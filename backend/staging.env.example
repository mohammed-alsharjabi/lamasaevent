# Copy values into the staging service's secret manager. Do not commit secrets.
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://staging.example.com
APP_KEY=

DB_CONNECTION=sqlite
DB_DATABASE=/absolute/path/to/staging.sqlite

SESSION_COOKIE=lams_staging_session
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

ADMIN_NAME=مدير الموقع
ADMIN_EMAIL=
ADMIN_PASSWORD=

FRONTEND_GIT_PUBLISH_ENABLED=false
FRONTEND_GIT_REPOSITORY_ROOT=
FRONTEND_GIT_SNAPSHOT_PATH=frontend/src/data/content-export.json
FRONTEND_GIT_REMOTE=git@github.com:mohammed-alsharjabi/lamasaevent.git
FRONTEND_GIT_BRANCH=feature/admin-cms
FRONTEND_GIT_SSH_KEY_PATH=

# Gateway protection is mandatory whenever STAGING_HOST is not loopback.
STAGING_HOST=127.0.0.1
STAGING_PORT=8080
STAGING_BACKEND_PORT=8081
STAGING_BASIC_USER=
STAGING_BASIC_PASSWORD=
